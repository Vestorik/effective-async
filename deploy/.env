# .env
SERVER_HOST=0.0.0.0
PORT=8000
WORKERS=1
RELOAD=True
LOG_LEVEL=debug
ACCESS_LOG=True

# PostgreSQL
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=effect_user
POSTGRES_PASSWORD=super_secret_password
POSTGRES_DB=effect_mobile_db

# Optional Postges
POSTGRES_POOL_SIZE=20
POSTGRES_POOL_TIMEOUT=30
POSTGRES_POOL_PRE_PING=true
POSTGRES_POOL_RECYCLE=3600
POSTGRES_ECHO=false
POSTGRES_MAX_OVERFLOW=20       